# ========================
# HuertoConnect — Variables de Entorno
# ========================
# Copia este archivo a .env y ajusta los valores para tu entorno.

# ── Node.js API (Express) ───────────────────────────────────────
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
FRONTEND_ORIGIN=http://localhost:4200
FRONTEND_LOGIN_PATH=/login
FRONTEND_DASHBOARD_PATH=/admin

# ── OTP / Mailer ───────────────────────────────────────────────
# Modo: "console" (dev, imprime en terminal) o "smtp" (correo real)
OTP_DELIVERY_MODE=console
OTP_EXPOSE_CODE_IN_RESPONSE=true
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# SMTP Gmail — solo requerido si OTP_DELIVERY_MODE=smtp
OTP_EMAIL_HOST=smtp.gmail.com
OTP_EMAIL_PORT=465
OTP_EMAIL_SECURE=true
OTP_EMAIL_USER=huertoconnect@gmail.com
OTP_EMAIL_APP_PASSWORD=your_gmail_app_password

# Alias fastapi-mail (microservicios Python)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=huertoconnect@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
MAIL_USERNAME=huertoconnect@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=huertoconnect@gmail.com
MAIL_SERVER=smtp.gmail.com
CONTACT_INBOX_EMAIL=huertoconnect@gmail.com

# ── Secretos de seguridad (CAMBIAR en producción) ──────────────
OTP_HASH_SECRET=change-this-otp-secret
OTP_LINK_SECRET=change-this-otp-link-secret
AUTH_PASSWORD_PEPPER=change-this-password-pepper

# ── JWT (microservicios Python) ────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
JWT_EXPIRE_HOURS=8

# ── MongoDB ────────────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=huerto_connect
MONGO_USER=huerto_admin
MONGO_PASSWORD=huerto_secret_2026
MONGO_URI=mongodb://huerto_admin:huerto_secret_2026@mongodb:27017/huerto_connect?authSource=admin
MONGO_URL=mongodb://huerto_admin:huerto_secret_2026@localhost:27017/huerto_connect?authSource=admin
DB_NAME=huerto_connect

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=huerto_connect_ai
POSTGRES_USER=huerto_pg_admin
POSTGRES_PASSWORD=huerto_pg_secret_2026
POSTGRES_URI=postgresql://huerto_pg_admin:huerto_pg_secret_2026@postgres:5432/huerto_connect_ai

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Cloudinary ─────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Admin Seed (microservicios Python) ─────────────────────────
ADMIN_EMAIL=admin@huertoconnect.com
ADMIN_PASSWORD=Admin123!
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Sistema
